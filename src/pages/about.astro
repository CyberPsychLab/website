---
import Base from "../layouts/Base.astro";
import { getSite } from "../lib/content";
const site = await getSite();
---
<Base title="About" description={site.about[0]}>
  <section class="page">
    <div class="pagehead"><span class="eyebrow">About</span><h1>About the {site.labName}</h1></div>
    <div class="about">
      <div class="prose">
        {site.about.map((para) => <p>{para}</p>)}
        {site.recentlyCompleted.length > 0 && (
          <>
            <h3 style="margin-top:12px;font-size:22px">Recently completed projects</h3>
            <ul class="methods">{site.recentlyCompleted.map((x) => <li>{x}</li>)}</ul>
          </>
        )}
      </div>
      <aside class="aside">
        <h3>Lab at a glance</h3>
        <dl>
          <div><dt>Principal Investigator</dt><dd>{site.piName}</dd></div>
          <div><dt>Department</dt><dd>{site.department.replace(/^Department of /, "")}, {site.university}</dd></div>
          <div><dt>Contact</dt><dd><a href={`mailto:${site.piEmail}`} style="font-family:var(--mono)">{site.piEmail}</a></dd></div>
          <div><dt>Joining the lab</dt><dd>Interested in becoming a research assistant? See <a href="/join/">Join the Lab</a>.</dd></div>
        </dl>
      </aside>
    </div>
  </section>
</Base>
