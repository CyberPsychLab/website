---
import Base from "../layouts/Base.astro";
import PubItem from "../components/PubItem.astro";
import { getPublications } from "../lib/content";
const pubs = await getPublications();
---
<Base title="Publications" description="Published papers, preprints, and work in progress from the CyberPsych Lab.">
  <section class="page">
    <div class="pagehead"><span class="eyebrow">Current &amp; Past Work</span><h1>Publications</h1><p>Published papers, preprints, and work in progress from the lab.</p></div>
    {pubs.length > 0 ? (
      <>
        <div class="filters" role="group" aria-label="Filter publications">
          <button type="button" data-f="all" aria-pressed="true">All</button>
          <button type="button" data-f="current" aria-pressed="false">Current work</button>
          <button type="button" data-f="past" aria-pressed="false">Past work</button>
        </div>
        <ul class="publist" id="pubs">{pubs.map((p) => <PubItem pub={p} />)}</ul>
        <p class="empty" id="pubs-empty" hidden>Nothing listed here yet.</p>
      </>
    ) : (
      <p class="empty">Publications will be listed here soon.</p>
    )}
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-f]");
  buttons.forEach((b) => b.addEventListener("click", () => {
    const f = b.dataset.f;
    buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    let shown = 0;
    document.querySelectorAll<HTMLElement>("#pubs .pub").forEach((li) => {
      li.hidden = f !== "all" && li.dataset.status !== f;
      if (!li.hidden) shown++;
    });
    const empty = document.getElementById("pubs-empty");
    if (empty) empty.hidden = shown > 0;
  }));
</script>
